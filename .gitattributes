# Normalise line endings to LF in the repo (the print agent is built for Windows, but sources stay LF)
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary

# Keep generated/reference HTML out of language stats and diffs noise
design/** linguist-documentation
design/**/*.html -diff
web/src/lib/api/schema.d.ts linguist-generated
