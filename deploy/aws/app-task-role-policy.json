{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CounterDropTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem",
        "dynamodb:Query", "dynamodb:TransactWriteItems", "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:<region>:<account-id>:table/cd-main",
        "arn:aws:dynamodb:<region>:<account-id>:table/cd-main/index/*"
      ]
    },
    {
      "Sid": "CounterDropFilesBucketMetadata",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::counter-drop-prod-files"
    },
    {
      "Sid": "CounterDropFilesObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::counter-drop-prod-files/*"
    }
  ]
}
