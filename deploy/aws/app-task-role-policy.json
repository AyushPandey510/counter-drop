{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CounterDropFilesBucketMetadata",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::counter-drop-prod-files"
    },
    {
      "Sid": "CounterDropFilesObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::counter-drop-prod-files/*"
    }
  ]
}
