# Copy to deploy/.env for local runs:  cp deploy/.env.example deploy/.env
# deploy/.env is git-ignored. Never commit real keys.

# --- API server ---
# Address the API listens on
CD_API_ADDR=:8080
# debug | info | warn | error
CD_LOG_LEVEL=info

# --- Database (docker compose "postgres" service, port 55433) ---
# Leave empty to use the in-memory demo store
CD_DATABASE_URL=postgres://counter_drop:counter_drop@localhost:55433/counter_drop?sslmode=disable

# --- Object storage (S3-compatible) ---
# Local dev target is Cloudflare R2 (build-plan step 02); MinIO image pulls failed on this machine.
# R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
CD_STORAGE_ENDPOINT=http://localhost:9000
CD_STORAGE_REGION=auto
CD_STORAGE_BUCKET=counter-drop-local
CD_STORAGE_ACCESS_KEY=counterdrop
CD_STORAGE_SECRET_KEY=counterdrop123

# --- Web ---
# Origin of the PWA (used for links and, from step 04, CORS)
CD_PUBLIC_BASE_URL=http://localhost:5173
