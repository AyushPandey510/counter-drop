# Copy to deploy/.env for local runs:  cp deploy/.env.example deploy/.env
# deploy/.env is git-ignored. Never commit real keys.

# --- API server ---
CD_ENV=dev                       # dev | prod (prod refuses a random storage signing key)
CD_API_ADDR=:8080
CD_LOG_LEVEL=info                # debug | info | warn | error
# Public URL of the API, used to build local-disk upload/download links
CD_PUBLIC_API_URL=http://localhost:8080
# Browser origins allowed by CORS (comma separated). Not needed when the API serves the web build.
CD_WEB_ORIGINS=http://localhost:5173
# Serve the built PWA from the API (single process, same origin). Empty = API only.
CD_WEB_DIR=
CD_MIGRATIONS_DIR=migrations
# Seed the "demo-print" shop (Owner PIN 1234, Kavita PIN 1111). Default: true in dev.
CD_DEMO_SEED=true

# --- Database (docker compose "postgres" service, port 55433). Required. ---
CD_DATABASE_URL=postgres://counter_drop:counter_drop@localhost:55433/counter_drop?sslmode=disable

# --- File storage ---
# Default: local disk. Files live in CD_STORAGE_DIR and are served by the API through
# HMAC-signed, short-lived links. Good for dev and a single-shop pilot on one server.
CD_STORAGE_DIR=.data/files
# Set a long random value so signed links survive restarts:  openssl rand -hex 32
CD_STORAGE_SIGNING_KEY=

# Cloudflare R2 (or any S3-compatible store): set all four to switch from local disk.
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
CD_STORAGE_ENDPOINT=
CD_STORAGE_REGION=auto
CD_STORAGE_BUCKET=
CD_STORAGE_ACCESS_KEY=
CD_STORAGE_SECRET_KEY=

# --- Rules (FSD defaults) ---
CD_UNDO_WINDOW=10m               # files deleted this long after "collected"
CD_ABANDON_AFTER=60m             # unsent drafts deleted after this
CD_DELETION_INTERVAL=30s         # how often the deletion worker runs
CD_MAX_FILE_MB=25
CD_MAX_JOB_MB=50
CD_MAX_FILES=20
CD_SESSION_TTL=12h               # staff sign-in lifetime
CD_SETUP_LINK_TTL=48h            # one-time PIN setup/reset links expire after this

# Where shops open the app. Used in setup links printed by cdadmin, e.g. https://counterdrop.in
# Default: CD_PUBLIC_API_URL when CD_WEB_DIR is set, otherwise the first CD_WEB_ORIGINS entry.
CD_PUBLIC_WEB_URL=
